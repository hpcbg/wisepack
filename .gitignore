# Build outputs
wisepack_ws/build/
wisepack_ws/install/
wisepack_ws/log/
__pycache__/
*.pyc
.pytest_cache/

# Run artefacts.
#
# results/ is regenerated by every run and its files are timestamped, so
# committing them means an ever-growing pile of near-duplicates. The CURATED
# demonstration evidence is committed deliberately (see the negations below);
# everything else is transient.
results/*
#!results/.gitkeep
#!results/wisepack-preset-summary.md

# Generated figures ARE committed: they are the presentation evidence and a
# reviewer must be able to see them without running anything.
!images/generated/

# Machine-local
.env
*.log

# The WISEPACK-owned perception runtime. Both are DISPOSABLE and are rebuilt on
# demand by scripts/setup_perception.sh: `.venv-perception/` holds torch,
# torchvision, OpenCV, fastapi and uvicorn for the host perception service, and
# `.cache-perception/` holds the ~159 MB detector weights. Neither belongs in
# Git — one is platform-specific binaries, the other is a model artefact.
.venv-perception/
.cache-perception/

# Host-specific settings (SSH port for the stream port-forward examples, etc).
# The TEMPLATE config/local.env.example IS tracked; the filled-in file is not.
config/local.env

# NVIDIA WebRTC runtime traces
NvStreamer-*.etli
